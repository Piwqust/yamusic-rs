// Переходы оригинала: `--ym-duration-transition` — 0,3 с, кривая CSS по умолчанию — ease
// (в Slint без указания была бы linear). В «Лёгком» режиме всё мгновенно.
export global Motion {
    out property <duration> t: App.motion ? 300ms : 0ms;
    // Проявление блока при смене трека: `fade-in .5s ease-in-out`.
    out property <duration> fade: App.motion ? 500ms : 0ms;
}

// Круг от нажатия, как у кнопок оригинала (`createRipple`): диаметром в большую сторону
// кнопки, за 0,6 с вырастает вчетверо и гаснет. Родитель обрезает его по своей форме.
export component Ripple inherits Rectangle {
    in property <color> ink: #ffffff3d;
    // Номер нажатия и его место: каждое новое нажатие запускает круг заново.
    in-out property <int> shot;
    in-out property <length> px;
    in-out property <length> py;
    public function play(x: length, y: length) {
        if App.motion {
            self.px = x;
            self.py = y;
            self.shot += 1;
        }
    }
    clip: true;
    for id in [root.shot]: Rectangle {
        property <float> p: root.shot > 0 ? 0 : 1;
        property <length> d: max(root.width, root.height) * 4 * self.p;
        init => { self.p = 1; }
        animate p { duration: 600ms; easing: linear; }
        visible: self.p < 1;
        x: root.px - self.d / 2;
        y: root.py - self.d / 2;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        background: root.ink.transparentize(self.p);
    }
}

// Точка у играющего трека: `PlayingAnimation_bubble-out .7s ease-in-out infinite`,
// масштаб 1,6 → 1 → 1,6.
export component PlayingDot inherits Rectangle {
    in property <bool> paused;
    property <float> s: 1.6;
    init => { self.s = 1; }
    animate s { duration: App.motion && !root.paused ? 350ms : 0ms; iteration-count: -1; direction: alternate; easing: ease-in-out; }
    width: 8px;
    height: 8px;
    Rectangle {
        width: 8px * (App.motion && !root.paused ? root.s : 1);
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.controls-color-primary-default-enabled;
    }
}

// Отклик значка на лайк, как `LikeButton_scale` и `LikeButton_unscale` оригинала:
// лайк — масштаб 1 → 1,1 → 1 за 0,4 с, снятие — качание на пиксель влево-вправо за 0,5 с.
export component LikePop inherits Rectangle {
    in property <bool> liked;
    out property <float> scale: 1;
    out property <length> shift: phase == 1 ? -1px + 2px * a : phase == 2 ? 1px - 1px * b : 0px;
    property <int> phase;
    property <float> a;
    property <float> b;
    animate scale { duration: 200ms; easing: ease; }
    animate a { duration: 250ms; easing: ease; }
    animate b { duration: 250ms; easing: ease; }
    changed liked => {
        if App.motion {
            if self.liked {
                self.scale = 1.1;
                back.running = true;
            } else {
                self.phase = 1;
                self.a = 1;
                half.running = true;
            }
        }
    }
    back := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            self.running = false;
            root.scale = 1;
        }
    }
    half := Timer {
        interval: 250ms;
        running: false;
        triggered => {
            self.running = false;
            if root.phase == 1 {
                root.phase = 2;
                root.b = 1;
                self.running = true;
            } else {
                root.phase = 0;
                root.a = 0;
                root.b = 0;
            }
        }
    }
}

// Блок, который проявляется заново при каждой смене `key` (например, трека):
// `animation: fade-in .5s ease-in-out` на элементе с React-ключом.
export component FadeOnKey inherits Rectangle {
    in property <string> key;
    in property <duration> duration: Motion.fade;
    out property <float> k: shown;
    property <float> shown: 1;
    property <bool> snap;
    // Сначала мгновенно в ноль, со следующего кадра — плавно к единице.
    animate shown { duration: root.snap ? 0ms : root.duration; easing: ease-in-out; }
    changed key => {
        if App.motion {
            self.snap = true;
            self.shown = 0;
            go.running = true;
        }
    }
    go := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.snap = false;
            root.shown = 1;
        }
    }
}

export component Icon inherits Image {
    in property <length> size: 24px;
    width: size;
    height: size;
    image-fit: contain;
}

export component HoverIcon inherits Rectangle {
    in property <image> source <=> glyph.source;
    in property <brush> colorize <=> glyph.colorize;
    in property <float> alpha: 1;
    in property <length> size: 24px;
    in property <bool> zoomed;
    // Отклик на лайк (`LikePop`): дополнительный масштаб и сдвиг значка.
    in property <float> pop-scale: 1;
    in property <length> pop-shift: 0px;
    property <float> zoom: zoomed ? 1.05 : 1;
    animate zoom { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
    width: size;
    height: size;
    // Округляем, как Skia при масштабе 1, чтобы значок не дёргался при наведении.
    pure function pixel-offset(pos: length) -> length { return round(pos / 1phx) * 1phx - pos; }
    glyph := Icon {
        x: root.pixel-offset(root.absolute-position.x) + root.pop-shift;
        y: root.pixel-offset(root.absolute-position.y);
        size: root.size;
        opacity: root.alpha;
        transform-scale: root.zoom * root.pop-scale;
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 24px;
    in property <brush> tint: Theme.controls-color-secondary-on-outline-enabled;
    in property <brush> hover-color: Theme.controls-color-primary-text-enabled-variant;
    in property <bool> enabled: true;
    callback clicked;
    width: size + 8px;
    height: size + 8px;
    Icon {
        source: icon;
        size: size;
        colorize: !enabled ? Theme.controls-color-primary-default-disabled : ta.has-hover ? hover-color : tint;
        animate colorize { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
    }
    ta := TouchArea {
        enabled: enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component BarButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 24px;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <brush> ink: #ffffff80;
    in property <brush> ink-hover: Theme.controls-color-secondary-text-hovered;
    in property <brush> ink-active: Theme.controls-color-primary-default-enabled;
    in property <bool> grow-on-hover;
    in property <bool> smooth-color: grow-on-hover;
    in property <brush> ink-off: #ffffff14;
    in property <float> pop-scale: 1;
    in property <length> pop-shift: 0px;
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: self.width / 2;
    HoverIcon {
        source: icon;
        size: root.icon-size;
        pop-scale: root.pop-scale;
        pop-shift: root.pop-shift;
        zoomed: root.grow-on-hover && ta.has-hover && root.enabled;
        colorize: !enabled ? ink-off : active ? ink-active : ta.has-hover ? ink-hover : ink;
        animate colorize { duration: App.motion && root.smooth-color ? Theme.duration-transition : 0ms; easing: ease; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Круглая кнопка на сером фоне (лайк, закреп, «ещё» в шапке страницы).
export component CircleButton inherits Rectangle {
    in property <image> icon;
    in property <length> diameter: 40px;
    in property <length> icon-size: 24px;
    in property <brush> icon-color: Theme.controls-color-secondary-on-default-enabled;
    callback clicked;
    width: diameter;
    height: diameter;
    border-radius: diameter / 2;
    background: ta.pressed ? Theme.controls-color-secondary-default-pressed
        : ta.has-hover ? Theme.controls-color-secondary-default-hovered
        : Theme.controls-color-secondary-default-enabled;
    animate background { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
    Icon { source: icon; size: icon-size; colorize: icon-color; }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> primary;
    callback clicked;
    height: 40px;
    width: label.preferred-width + (has-icon ? 24px + 4px : 0px) + 2 * 16px;
    border-radius: self.height / 2;
    background: primary
        ? (ta.pressed ? Theme.controls-color-primary-default-pressed : ta.has-hover ? Theme.controls-color-primary-default-hovered : Theme.controls-color-primary-default-enabled)
        : (ta.pressed ? Theme.controls-color-secondary-default-pressed : ta.has-hover ? Theme.controls-color-secondary-default-hovered : Theme.controls-color-secondary-default-enabled);
    animate background { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        if has-icon: Icon {
            y: (parent.height - self.height) / 2;
            source: icon;
            size: 24px;
            colorize: primary ? Theme.controls-color-primary-on-default-enabled : Theme.controls-color-secondary-on-default-enabled;
        }
        label := Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.font-size-label-m;
            font-weight: 500;
            color: primary ? Theme.controls-color-primary-on-default-enabled : Theme.controls-color-secondary-on-default-enabled;
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component Shimmer inherits Rectangle {
    background: Theme.background-color-primary-enabled-shimmer;
}

// Обложка с image-fit: cover. Если картинка декодирована под экран (±2%), она рисуется
// без сглаживания: вид тот же, а билинейной выборки на каждом кадре нет. Иначе — сглаживание.
export component Pic inherits Image {
    image-fit: cover;
    property <float> ratio: max(self.width / 1px * App.dpr / max(1, self.source.width), self.height / 1px * App.dpr / max(1, self.source.height));
    image-rendering: self.ratio > 0.98 && self.ratio < 1.02 ? pixelated : smooth;
}

export component Cover inherits Rectangle {
    in property <image> source;
    in property <length> radius: Theme.radius-size-m;
    in property <bool> round;
    // Прозрачность картинки без слоя: opacity на самой Cover в Skia стоит отдельного слоя.
    in property <float> alpha: 1;
    border-radius: round ? self.width / 2 : radius;
    clip: true;
    // Заглушка только до загрузки: под картинкой полупрозрачная заливка — лишний проход по пикселям.
    background: root.source.width > 0 ? transparent : Theme.controls-color-secondary-default-enabled;
    Pic {
        width: parent.width;
        height: parent.height;
        source: root.source;
        opacity: root.alpha;
    }
}

// Поле ввода: Ctrl+A/C/V/X/Z работают и на русской раскладке.
export component Field inherits TextInput {
    selection-background-color: #5c8ff566;
    selection-foreground-color: self.color;
    callback escape();
    key-pressed(e) => {
        if e.text == Key.Escape {
            self.escape();
            return reject;
        }
        if !e.modifiers.control || e.modifiers.alt {
            return reject;
        }
        if e.text == "ф" || e.text == "Ф" || e.text == "a" || e.text == "A" {
            self.select-all();
            return accept;
        }
        if e.text == "с" || e.text == "С" {
            self.copy();
            return accept;
        }
        if e.text == "м" || e.text == "М" {
            self.paste();
            return accept;
        }
        if e.text == "ч" || e.text == "Ч" {
            self.cut();
            return accept;
        }
        if e.text == "я" || e.text == "Я" {
            self.undo();
            return accept;
        }
        reject
    }
}

// Исполнители через запятую, каждый открывается отдельно.
export component ArtistLinks inherits Rectangle {
    in property <[string]> names;
    in property <length> font-size: Theme.font-size-label-m;
    in property <brush> ink: Theme.controls-color-primary-text-enabled;
    in property <brush> ink-hover: Theme.controls-color-primary-text-enabled-variant;
    in property <bool> links: true;
    out property <length> content-width: row.preferred-width;
    callback clicked(int);
    clip: true;
    row := HorizontalLayout {
        alignment: start;
        for n[i] in root.names: Text {
            text: i < root.names.length - 1 ? n + ", " : n;
            vertical-alignment: center;
            horizontal-stretch: 0;
            font-size: root.font-size;
            font-weight: 500;
            color: ta.has-hover && root.links ? root.ink-hover : root.ink;
            animate color { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
            ta := TouchArea {
                enabled: root.links;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.clicked(i); }
            }
        }
    }
}

// Значок «!» у трека с ограничением: при наведении показывает пояснение.
export component ExplicitMark inherits Rectangle {
    in property <brush> ink: Theme.controls-color-primary-text-enabled;
    in property <length> size: 18px;
    width: size;
    height: size;
    Image {
        width: root.size;
        height: root.size;
        source: Icons.exclamation;
        colorize: ta.has-hover ? Theme.controls-color-primary-text-enabled-variant : root.ink;
        image-fit: contain;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        changed has-hover => {
            if self.has-hover {
                App.hint-x = root.absolute-position.x + root.width / 2;
                App.hint-y = root.absolute-position.y;
                App.hint-open = true;
            } else {
                App.hint-open = false;
            }
        }
        clicked => {
            App.hint-x = root.absolute-position.x + root.width / 2;
            App.hint-y = root.absolute-position.y;
            App.hint-open = true;
        }
    }
}

export component NavCircle inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: !enabled ? Theme.controls-color-secondary-default-disabled : ta.has-hover ? Theme.controls-color-secondary-default-hovered : Theme.controls-color-secondary-default-enabled;
    animate background { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
    Icon { source: icon; size: 20px; colorize: enabled ? Theme.controls-color-secondary-on-default-enabled : Theme.controls-color-secondary-on-default-disabled; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Назад и вперёд по истории, как в браузере.
export component NavArrows inherits HorizontalLayout {
    spacing: 8px;
    NavCircle { icon: Icons.arrow-left-small; enabled: App.can-back; clicked => { App.go-back(); } }
    NavCircle { icon: Icons.arrow-right-small; enabled: App.can-forward; clicked => { App.go-forward(); } }
}

// Плавное появление содержимого: страницы, меню, окна. Работает при создании элемента.
export component Fade inherits Rectangle {
    in property <length> rise: 0px;
    in property <duration> duration: App.motion ? 220ms : 0ms;
    in property <easing> curve: ease-out;
    property <float> k: App.motion ? 0 : 1;
    init => { k = 1; }
    animate k { duration: root.duration; easing: root.curve; }
    Rectangle {
        y: (1 - root.k) * root.rise;
        width: root.width;
        height: root.height;
        opacity: root.k;
        @children
    }
}

// Полоса прокрутки поверх страницы — `OverlayScrollbar` оригинала. Ставится рядом с Flickable
// на его место, `content-y` связывается с ним в обе стороны. Бегунок 8 px со скруглением,
// отступ 8 px от краёв, не короче 50 px. Виден, пока страница прокручивается, и гаснет через
// секунду после остановки (`useScroll`: debounce 1 с), появляется и гаснет за 0,2 с ease-in-out.
// Бегунок можно тянуть. У оригинала он прозрачный, а цвет даёт `backdrop-filter: invert(0.3)`
// (под курсором 0,4); на тёмном фоне это около 30% и 40% белого.
export component ScrollBar inherits Rectangle {
    in-out property <length> content-y;
    in property <length> content-height;
    property <length> pad: 8px;
    property <length> track: root.height - 2 * pad;
    property <length> range: max(0px, content-height - root.height);
    property <length> size: max(50px, track * min(1, root.height / max(1px, content-height)));
    property <float> value: range > 0 ? max(0, min(1, -content-y / range)) : 0;
    property <bool> scrolling;
    property <bool> dragging: thumb-ta.pressed;
    property <float> shown: range > 0 && (scrolling || dragging) ? 1 : 0;
    animate shown { duration: App.motion ? 200ms : 0ms; easing: ease-in-out; }
    changed content-y => {
        root.scrolling = true;
        // `restart()` не запускает остановленный таймер: сначала включаем, потом отсчёт заново.
        idle.running = true;
        idle.restart();
    }
    idle := Timer {
        interval: 1s;
        running: false;
        triggered => {
            self.running = false;
            root.scrolling = false;
        }
    }

    thumb := Rectangle {
        x: root.width - root.pad - self.width;
        y: root.pad + (root.track - root.size) * root.value;
        width: 8px;
        height: root.size;
        border-radius: 4px;
        visible: root.shown > 0;
        property <bool> hot: thumb-ta.has-hover || root.dragging;
        background: (Theme.dark ? #ffffff : #000000).with-alpha((self.hot ? 0.4 : 0.3) * root.shown);
        animate background { duration: App.motion ? 200ms : 0ms; easing: ease-in-out; }
        property <length> grab-y;
        property <float> grab-value;
        thumb-ta := TouchArea {
            enabled: root.shown > 0;
            pointer-event(e) => {
                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                    thumb.grab-y = self.absolute-position.y + self.mouse-y;
                    thumb.grab-value = root.value;
                }
            }
            moved => {
                if self.pressed && root.track > root.size {
                    root.content-y = -root.range * max(0, min(1, thumb.grab-value
                        + (self.absolute-position.y + self.mouse-y - thumb.grab-y) / (root.track - root.size)));
                }
            }
        }
    }
}
